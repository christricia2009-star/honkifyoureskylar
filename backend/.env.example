# Copy to backend/.env. Honk loads .env from the working directory when you
# run the server from backend/. Git ignores .env. Leave the Tesla values empty
# to keep the demo. Fill them in only on the machine that runs the server.
# Never put the client secret or the private key in the iOS app.

TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
DOMAIN=skylar.snapcollectibles.com
TESLA_REDIRECT_URI=https://skylar.snapcollectibles.com/path
FLEET_API_BASE=https://fleet-api.prd.na.vn.cloud.tesla.com
TESLA_AUTH_URL=https://auth.tesla.com/oauth2/v3/authorize
TESLA_TOKEN_URL=https://fleet-auth.prd.vn.cloud.tesla.com/oauth2/v3/token

# EC P-256 private key. Generate it with the openssl commands in the README.
# The matching public key is served from the domain.
TESLA_PRIVATE_KEY_FILE=secrets/private-key.pem
TESLA_PUBLIC_KEY_FILE=../docs/.well-known/appspecific/com.tesla.3p.public-key.pem
DOCS_DIR=../docs

DATABASE_PATH=data/honk.db
ADDR=:8080

# Required if anything other than this machine posts telemetry.
# When empty, ingest is accepted only from loopback.
TELEMETRY_INGEST_TOKEN=
# When empty, POST /admin/register answers 404.
ADMIN_TOKEN=

# Fleet Telemetry server (not this static site, and not GitHub Pages).
TELEMETRY_HOST=skylar.snapcollectibles.com
TELEMETRY_PORT=443
TELEMETRY_CA_FILE=

# Optional Apple push. Alerts still save and the phone can notify locally.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY_FILE=
APNS_BUNDLE_ID=com.example.honkifyoureskylar
# APNS_ENV=production

# Set to false to freeze the demo car.
DEMO_AUTOPLAY=true
