{
  "host": "0.0.0.0",
  "port": 443,
  "log_level": "info",
  "json_log_enable": true,
  "namespace": "honk",
  "reliable_ack": false,
  "transmit_decoded_records": true,
  "logger": { "verbose": true },
  "records": {
    "V": ["logger"],
    "alerts": ["logger"],
    "errors": ["logger"],
    "connectivity": ["logger"]
  },
  "tls": {
    "server_cert": "/etc/certs/server/fullchain.pem",
    "server_key": "/etc/certs/server/privkey.pem"
  }
}
